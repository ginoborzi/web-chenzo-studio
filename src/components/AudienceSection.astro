---
const audiences = [
	{
		title: 'Marcas personales',
		description: 'Profesionales y creadores que necesitan una voz clara y constante en redes.',
		icon: `<circle cx="12" cy="8" r="4" stroke="var(--brand)" stroke-width="1.6"/><path d="M4 20c0-4.4 3.6-7 8-7s8 2.6 8 7" stroke="var(--brand)" stroke-width="1.6"/>`,
	},
	{
		title: 'Organizaciones',
		description: 'Instituciones y equipos que necesitan comunicar con orden y estrategia.',
		icon: `<rect x="4" y="4" width="7" height="7" stroke="var(--brand)" stroke-width="1.6"/><rect x="13" y="4" width="7" height="7" stroke="var(--brand)" stroke-width="1.6"/><rect x="4" y="13" width="7" height="7" stroke="var(--brand)" stroke-width="1.6"/><rect x="13" y="13" width="7" height="7" stroke="var(--brand)" stroke-width="1.6"/>`,
	},
	{
		title: 'Comercios',
		description: 'Negocios que buscan más visibilidad, más alcance y más ventas medibles.',
		icon: `<path d="M4 9l1-5h14l1 5" stroke="var(--brand)" stroke-width="1.6"/><path d="M4 9h16v11H4z" stroke="var(--brand)" stroke-width="1.6"/>`,
	},
];
---

<section id="para-quien">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">Para quién</span>
			<h2>Trabajamos con tres tipos de marca.</h2>
		</div>
		<div class="audience-grid">
			{audiences.map((audience) => (
				<div class="audience-card">
					<svg class="glyph" viewBox="0 0 24 24" fill="none" set:html={audience.icon} />
					<h3>{audience.title}</h3>
					<p>{audience.description}</p>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.audience-grid {
		margin-top: 56px;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
	}

	.audience-card {
		background: var(--surface);
		padding: 38px 30px;
		display: flex;
		flex-direction: column;
		gap: 14px;
		min-height: 210px;
	}

	.audience-card .glyph {
		width: 34px;
		height: 34px;
	}

	.audience-card h3 {
		font-size: 19px;
		font-weight: 700;
	}

	.audience-card p {
		font-size: 15px;
		color: var(--ink-soft);
	}

	@media (max-width: 860px) {
		.audience-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
