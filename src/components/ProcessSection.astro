---
const steps = [
	{
		num: '01 — Planificar',
		title: 'Estrategia de contenido',
		description: 'Definimos objetivos, pilares de contenido y calendario editorial a medida de tu marca personal, organización o comercio.',
	},
	{
		num: '02 — Crear',
		title: 'Producción y edición',
		description: 'Creamos y editamos el contenido — reels, carruseles, fotografía y copy — listo para publicar en tus canales.',
	},
	{
		num: '03 — Optimizar',
		title: 'Campañas en Meta Ads',
		description: 'Ideamos, analizamos y optimizamos campañas en Meta Ads para que el contenido llegue a quien tiene que llegar.',
	},
];
---

<section id="servicios">
	<div class="wrap">
		<div class="section-head">
			<span class="eyebrow">Cómo trabajamos</span>
			<h2>Un proceso, tres etapas.</h2>
			<p>Cada marca pasa por el mismo recorrido: primero se piensa, después se produce y por último se optimiza con datos reales de campaña.</p>
		</div>
		<div class="process-list">
			{steps.map((step) => (
				<div class="process-item">
					<span class="process-num">{step.num}</span>
					<div class="process-body">
						<h3>{step.title}</h3>
						<p>{step.description}</p>
					</div>
				</div>
			))}
		</div>
	</div>
</section>

<style>
	.process-list {
		margin-top: 56px;
		display: flex;
		flex-direction: column;
	}

	.process-item {
		display: grid;
		grid-template-columns: 100px 1fr;
		gap: 32px;
		align-items: start;
		padding: 34px 0;
		border-top: 1px solid var(--border);
	}

	.process-item:last-child {
		border-bottom: 1px solid var(--border);
	}

	.process-num {
		font-size: 15px;
		font-weight: 300;
		color: var(--brand);
		letter-spacing: 0.02em;
		padding-top: 4px;
	}

	.process-body h3 {
		font-size: 23px;
		font-weight: 700;
	}

	.process-body p {
		margin-top: 10px;
		font-size: 16px;
		color: var(--ink-soft);
		max-width: 60ch;
	}

	@media (max-width: 860px) {
		.process-item {
			grid-template-columns: 1fr;
			gap: 8px;
			padding: 28px 0;
		}

		.process-num {
			padding-top: 0;
		}
	}
</style>
